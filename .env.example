# ==============================================================================
# Backend Configuration (.env)
# ==============================================================================

# Database Configuration
# Local SQLite default: sqlite+aiosqlite:///./local_dev.db
# Or PostgreSQL / Supabase connection string:
DATABASE_URL=sqlite+aiosqlite:///./local_dev.db

# Supabase (Optional if using Supabase directly)
SUPABASE_URL=
SUPABASE_KEY=

# Google Gemini API (Used for OCR & RAG Health Assistant)
GEMINI_API_KEY=

# Firebase Admin SDK & Web API
FIREBASE_SERVICE_ACCOUNT_PATH=firebase-service-account.json
FIREBASE_WEB_API_KEY=

# Test / Verification Config (Optional)
TEST_EMAIL_ADDRESS=
TEST_PHONE_NUMBER=

# ==============================================================================
# Frontend Configuration (.env / .env.local)
# ==============================================================================

# Firebase Client Web SDK Config
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=